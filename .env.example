# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Twilio Integration for real SMS OTP verification:
# If provided, the app will send a real 6-digit SMS verification code to the phone number.
# If omitted, it will run in a safe local simulation/development mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Google Cloud API Key for Neural2 High-Quality Voice Synthesis (Google Text-to-Speech):
# If set, the applet will fetch ultra-realistic 24kHz deep learning voices (fr-FR-Neural2-B / C) from Google Cloud.
# Falls back automatically to GEMINI_API_KEY, or to browser-native Web Speech API if disabled.
GOOGLE_CLOUD_API_KEY=

# Optional ElevenLabs API Key for ultra-realistic voice synthesis (ElevenLabs):
# If set, the app can synthesize voices with supreme quality using professional French ElevenLabs voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Sécurité production (ajouté lors de l'audit) ---

# NODE_ENV: mettre à "production" en production réelle.
# Active plusieurs protections : Twilio devient obligatoire, le code OTP n'est jamais renvoyé au client,
# et le OTP de test développeur (DEV_MASTER_OTP) est désactivé.
NODE_ENV=production

# ADMIN_SECRET: code secret pour accéder au panneau Admin et aux routes /api/admin/*.
# Choisissez une chaîne longue et aléatoire. Sans cette variable, tout accès admin est refusé (fail-closed).
ADMIN_SECRET=

# DEV_MASTER_OTP: code OTP de test pour le développement uniquement.
# Ignoré automatiquement si NODE_ENV=production. Ne jamais définir en production.
DEV_MASTER_OTP=
